{
  "expo": {
    "name": "Tasko",
    "slug": "taskflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "taskflow",
    "android": {
      "package": "com.yuvarajadithya.tasko"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuvarajadithya.tasko"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f2832642-4bd0-4e26-8970-efa175cca78a"
      }
    }
  }
}