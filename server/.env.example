DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
PORT=5000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Production requires a unique JWT_SECRET of at least 32 characters.
# Leave proxy trust disabled for direct connections. Behind Render/Railway, set
# only the actual trusted ingress IPs/CIDRs for your deployment, comma-separated.
# Express subnet names (loopback, linklocal, uniquelocal) are also supported only
# when those entire ranges are trusted. Never use true, hop counts, or /0 ranges.
# Verify that your proxy overwrites forwarded headers before enabling this.
TRUST_PROXY=false
